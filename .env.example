# Copy this file to ".env" and adjust the values before running docker compose.
# The .env file is git-ignored so real secrets never get committed.

# Shared HMAC secret used to sign (auth-service) and verify (blacklist-service)
# JWTs. MUST be the same for both services and at least 16 characters.
# Generate a strong one, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-value

# Shared Bearer API key that the auth and blacklist services use to call the
# internal data-service. Required, at least 16 characters.
# Generate a strong one, e.g.: openssl rand -hex 32
DATA_SERVICE_API_KEY=replace-with-a-long-random-api-key

# ODBC DSN for the data-service storage backend. Defaults to a local SQLite
# database on the persisted volume. Point this at any ODBC-reachable database to
# switch backends, e.g.:
#   Driver=PostgreSQL Unicode;Server=db;Port=5432;Database=fency;Uid=...;Pwd=...;
ODBC_DSN=Driver=SQLite3;Database=/data/fency.db;

# Token issuer claim — must match in both services.
JWT_ISSUER=fency-auth

# How long issued tokens remain valid (Go duration syntax).
TOKEN_TTL=60m

# Predefined test user credentials.
SEED_USER=admin
SEED_USER_PASSWORD=ChangeMe123!

# Domains the blacklist starts with (comma-separated).
SEED_DOMAINS=malware-example.com,phishing-example.net

# Origins allowed by CORS (comma-separated). The Vite dev server defaults to
# http://localhost:5173.
ALLOWED_ORIGINS=http://localhost:5173
